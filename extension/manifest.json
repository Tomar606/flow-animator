{
  "manifest_version": 3,
  "name": "Flow Animator Bridge",
  "version": "1.0.0",
  "description": "Fills Google Flow with topic briefs from the local bridge and downloads the finished clips under their topic ids.",
  "permissions": ["downloads", "storage", "scripting", "activeTab", "debugger", "tabs"],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*", "https://flow.google/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Flow Animator Bridge" }
}
